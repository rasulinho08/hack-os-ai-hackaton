{
  "name": "hackos-api",
  "version": "1.0.0",
  "description": "HackOS — hackathon management API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node src/db/migrate.js",
    "migrate:status": "node src/db/migrate.js status",
    "seed": "node scripts/seed-test-data.js",
    "seed:demo": "node scripts/seed-demo.js",
    "lint": "eslint src server.js scripts tests",
    "lint:fix": "eslint src server.js scripts tests --fix",
    "test": "node --test tests/*.test.js",
    "create-admin": "node scripts/create-admin.js",
    "backfill-orders": "node scripts/backfill-orders.js",
    "grant-superadmin": "node scripts/grant-superadmin.js",
    "test:unit": "node --test tests/participantInvites.unit.test.js tests/authz.test.js tests/tenancy.test.js tests/email.test.js tests/tenantAccess.test.js tests/builder.unit.test.js tests/csv.unit.test.js tests/autoAnnouncements.unit.test.js tests/eventProgress.unit.test.js tests/matchmaking.unit.test.js tests/eventOverview.unit.test.js tests/zip.unit.test.js tests/certificatePdf.unit.test.js tests/archiveGuard.unit.test.js tests/ics.unit.test.js tests/secretBox.unit.test.js tests/report.unit.test.js"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.1.7",
    "pdf-lib": "^1.17.1",
    "pg": "^8.11.5",
    "qrcode-generator": "2.0.4",
    "zod": "^3.22.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "qs": "^6.16.1"
  },
  "devDependencies": {
    "eslint": "^10.1.0"
  }
}
