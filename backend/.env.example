# =============================================================================
# HackOS API — environment variables
# Copy to .env for local development. In Docker / production pass them as
# real environment variables (never commit .env).
# =============================================================================

# ─── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string
#   local (docker compose in repo root): postgresql://hackos:hackos_dev_password@localhost:5432/hackos
#   docker network:                      postgresql://hackos:<password>@postgres:5432/hackos
DATABASE_URL=postgresql://hackos:hackos_dev_password@localhost:5432/hackos

# JWT signing secret — at least 32 chars in production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change_this_to_a_long_random_secret
# Optional: signs invitation links (and calendar feed links) with a key of its
# own; falls back to JWT_SECRET. Changing it voids every link already sent.
# INVITE_TOKEN_SECRET=
# Seals stored secrets (an event's online room link) with AES-256-GCM.
# 32 bytes as base64 or hex: openssl rand -base64 32. Keep it safe: values
# sealed with a lost key cannot be read back. To rotate, move the old key to
# DATA_ENCRYPTION_KEY_PREVIOUS (comma list) and set a new one. Without a key
# values are stored as they are.
# DATA_ENCRYPTION_KEY=
# DATA_ENCRYPTION_KEY_PREVIOUS=

# ─── Server ──────────────────────────────────────────────────────────────────

# development | production  (production hides error details, forces Secure cookies)
NODE_ENV=development
PORT=5000

# Apply db/migrations/*.sql on boot (default true). Set to false when you run
# `npm run migrate` as a separate deploy step.
RUN_MIGRATIONS_ON_START=true

# Max JSON body size (CSV bulk import needs more than the Express default)
# JSON_BODY_LIMIT=2mb

# ─── Frontend origins (CORS + links in e-mails) ──────────────────────────────
# Comma-separated list of browser origins allowed to call the API.
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000
# Base URL used in e-mails (falls back to the first FRONTEND_URLS entry).
FRONTEND_URL=http://localhost:3000

# ─── Session cookie ──────────────────────────────────────────────────────────
# lax (default, recommended when the web app proxies /api to this server on
# the same domain — e.g. nginx on hack-os.app) | none (web app and API on
# different domains; requires HTTPS) | strict
# COOKIE_SAME_SITE=lax
# Secure flag: defaults to true in production. Only set false for plain-http staging.
# COOKIE_SECURE=true
# Share the cookie across subdomains, e.g. .hack-os.app
# COOKIE_DOMAIN=
# Session lifetime (hackathons run for days) — default 30d / 30 days in ms
# JWT_EXPIRES_IN=30d
# SESSION_COOKIE_MAX_AGE_MS=2592000000

# ─── TLS to the database ─────────────────────────────────────────────────────
# disable (docker / localhost — auto-detected) | require | no-verify (managed
# providers such as Supabase/Neon — auto-detected). Force with:
# DATABASE_SSL=disable

# ─── Rate limiting ───────────────────────────────────────────────────────────
# Login/register: counts FAILED attempts per IP — default 100 per 15 min.
# Global API limiter: per signed-in user (IP for anonymous) — default 1200 per minute.
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=100
# GLOBAL_RATE_LIMIT_WINDOW_MS=60000
# GLOBAL_RATE_LIMIT_MAX=1200
# File uploads (logos, registration attachments), per user or address.
# UPLOAD_RATE_LIMIT_WINDOW_MS=900000
# UPLOAD_RATE_LIMIT_MAX=60
# Failed event registrations per address (successful ones are not counted).
# REGISTER_RATE_LIMIT_WINDOW_MS=900000
# REGISTER_RATE_LIMIT_MAX=200
# Public lookups by code or token (certificate check, calendar feeds): only misses count.
# LOOKUP_RATE_LIMIT_WINDOW_MS=900000
# LOOKUP_RATE_LIMIT_MAX=300
# Exports (event ZIP, participant and audit CSV) per account.
# EXPORT_RATE_LIMIT_WINDOW_MS=600000
# EXPORT_RATE_LIMIT_MAX=30
# Proxy hops to trust for the real client IP: 1 (default) | loopback,uniquelocal (nginx + docker)
# TRUST_PROXY=1

# ─── Tenancy ─────────────────────────────────────────────────────────────────
# Organisers see events they created and events of their own customer. Events
# with no customer are visible only to their creator and the platform owner.
# true shares unassigned events with every organiser — only for a
# single-organisation installation with no public checkout.
# LEGACY_SHARED_EVENTS=false

# ─── E-mail ──────────────────────────────────────────────────────────────────
# Invites, registration/approval notices, password resets and submission
# receipts. Full setup (provider, DNS records, test): docs/EMAIL.md.
# Picked in this order unless MAIL_PROVIDER names one: Resend, Brevo, SMTP.
# Prefer an HTTPS provider on Render — its free plan blocks outbound SMTP.
# RESEND_API_KEY=
# BREVO_API_KEY=
# MAIL_PROVIDER=                # resend | brevo | smtp (optional)
# The sender must be on a domain verified with the provider.
# MAIL_FROM_EMAIL=no-reply@hack-os.app
# MAIL_FROM_NAME=HackOS
# MAIL_REPLY_TO=                # where replies go, e.g. a monitored inbox
# SALES_NOTIFY_EMAIL=           # gets new-order and contact-form alerts
#
# Where the platform itself lives, for setup links (falls back to FRONTEND_URL).
# APP_ORIGIN=https://app.hack-os.app
#
# Invoices (PDF). The owner sets the seller's legal, bank and VAT details in
# the console (Settings → Billing and invoices); these fill any field left
# empty there. While the bank details are empty the invoice says they follow
# by e-mail. See docs/COMMERCE.md.
# INVOICE_SELLER_NAME=HackOS
# INVOICE_SELLER_ADDRESS=Street 1|Baku AZ1000|Azerbaijan
# INVOICE_SELLER_TAX_ID=
# INVOICE_SELLER_EMAIL=
# INVOICE_BANK_NAME=
# INVOICE_BANK_ACCOUNT_HOLDER=
# INVOICE_BANK_IBAN=
# INVOICE_BANK_SWIFT=
# Card payment at checkout: the name of a registered card provider. Unset (as
# today: none is connected) = bank transfer only. See docs/COMMERCE.md,
# "Taking cards".
# PAYMENT_CARD_PROVIDER=
#
# SMTP, only if no API key is set. 465 + SMTP_SECURE=true, or 587 (STARTTLS).
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
#
# Which events send mail (defaults shown).
# SEND_EMAIL_ON_REGISTRATION=true
# SEND_EMAIL_ON_PARTICIPANT_APPROVED=true
# SEND_EMAIL_ON_SUBMISSION=true
# SEND_EMAIL_ON_EVENT_INVITE=false   # true: e-mail as soon as an invite row is added

# ─── Telegram (one platform bot for every organisation) ─────────────────────
# See docs/TELEGRAM.md. Organisers connect their event's channel and
# participants their own chat from the app; nothing here names a channel.
# TELEGRAM_ENABLED=true
# TELEGRAM_BOT_TOKEN=          # from @BotFather
# TELEGRAM_WEBHOOK_SECRET=     # any long random string; the webhook stays shut without it
# TELEGRAM_WEBHOOK_URL=https://hackos-api.onrender.com/api/telegram/webhook   # set at boot when present
# Only for the platform's own events from before organisations (no customer):
# TELEGRAM_CHAT_ID=            # -100… id or @channel
# TELEGRAM_API_BASE=           # tests only: a fake Bot API server

# ─── Background jobs ─────────────────────────────────────────────────────────
# Scheduled announcements, e-mail and Telegram deliveries, automatic
# announcements. Every instance runs the worker unless told not to.
# JOBS_DISABLED=false
# JOBS_INTERVAL_MS=15000
# AUTO_ANNOUNCE_EVERY_MS=60000
# Published events are archived (read-only) 14 days after they end; organisers
# can bring one back. off = only organisers archive.
# AUTO_ARCHIVE=on
# ARCHIVE_EVERY_MS=3600000
# The event ZIP export includes uploaded files up to this many MB in total.
# EXPORT_FILES_MAX_MB=25

# ─── GitHub check of project repositories (optional, per event) ─────────────
# Public repositories only. Without a token GitHub allows 60 requests an hour
# from one address (three per project); a fine-grained token with no
# permissions raises that to 5000.
# GITHUB_TOKEN=
# GITHUB_API_BASE=             # tests only: tests/fakeGithub.js


# ─── Platform owner ──────────────────────────────────────────────────────────
# The only addresses that may act as platform owner (superadmin). A superadmin
# row for any other address works as a plain admin.
# SUPERADMIN_EMAILS=you@example.com
# Second step after the password for the owner: a code only you know. Set it
# here in the server's environment, never in code. Unset = no second step.
# SUPERADMIN_PIN=

# Promotes an EXISTING account to superadmin once, at boot, then does nothing
# (see docs/OWNER_SETUP.md). Remove it after the log confirms the promotion.
# BOOTSTRAP_SUPERADMIN_EMAIL=you@example.com

# ─── Database pool / TLS details ─────────────────────────────────────────────
# Connections in the pg pool (default 10).
# PG_POOL_MAX=10
# Certificate checking is derived from DATABASE_URL (sslmode) and DATABASE_SSL.
# These two older switches are still honoured: NODE_TLS_REJECT_UNAUTHORIZED=0
# disables verification process-wide; DATABASE_SSL_REJECT_UNAUTHORIZED=false
# disables it for Postgres only. Prefer DATABASE_SSL=no-verify.
# DATABASE_SSL_REJECT_UNAUTHORIZED=
# SMTP: set 0 only for a relay with a self-signed certificate.
# SMTP_TLS_REJECT_UNAUTHORIZED=1

# ─── Scripts (not read by the server) ────────────────────────────────────────
# npm run create-admin — defaults when the e-mail/password/name are not passed
# as arguments.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrator
# npm run seed — password given to every seeded test account (default Test1234!).
# SEED_PASSWORD=

# ─── Uploaded files ──────────────────────────────────────────────────────────
# Uploads (event logos and banners, sponsor logos, certificate signatures,
# registration attachments such as CVs) are stored in Postgres. This caps the
# total so the database cannot fill up; uploads past it are refused with a
# clear message. Each plan's own storage (1/5/20 GB) is enforced as well.
# On Supabase's free tier (500 MB database) keep this well below the limit.
# STORAGE_DB_MAX_MB=300

# ─── Event chat ───────────────────────────────────────────────────────────────
# New messages wake waiting readers on every instance through Postgres
# LISTEN/NOTIFY. Set off when the database URL is a pooler in transaction mode
# (it cannot LISTEN); a single instance does not need it.
# CHAT_PG_LISTEN=on
# Messages one account may send per 30 seconds.
# CHAT_POST_LIMIT_PER_30S=20

# ─── Outgoing webhooks ───────────────────────────────────────────────────────
# Organisations' endpoints must be public https:// addresses (docs/WEBHOOKS.md).
# true also allows http:// and loopback or private-network targets: local
# development, tests, an installation that delivers inside its own network.
# Defaults to true when NODE_ENV is development or test, false otherwise.
# WEBHOOKS_ALLOW_PRIVATE_TARGETS=false
# Per account per minute: saving endpoints; test sends and redeliveries.
# WEBHOOK_WRITE_LIMIT_PER_MIN=30
# WEBHOOK_SEND_LIMIT_PER_MIN=20

# ─── AI (Meta Model API) ─────────────────────────────────────────────────────
# Key from dev.meta.ai → API keys. Unset = AI features off (/api/ai/status says so).
# MODEL_API_KEY=
# META_AI_BASE_URL=https://api.meta.ai/v1
# META_AI_MODEL=muse-spark-1.2
# META_AI_TIMEOUT_MS=60000
# Calls per account per window (each spends credits).
# AI_RATE_LIMIT_WINDOW_MS=3600000
# AI_RATE_LIMIT_MAX=20
