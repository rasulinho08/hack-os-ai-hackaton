# =============================================================================
# HackOS web app — environment variables
#
# Copy to .env.local for local development. On Vercel / Docker set them as real
# environment variables. NEXT_PUBLIC_* values are inlined at BUILD time: changing
# one after a deploy needs a rebuild, not a restart.
# =============================================================================

# ─── Required ────────────────────────────────────────────────────────────────

# Origin of the Express API. Used by next.config.ts (rewrites /api/* that no
# local route handler serves) and by the middleware session check. Accepts
# http://host:port or http://host/api; the trailing /api is stripped.
#   local:           http://localhost:5000
#   docker compose:  http://api:5000
#   production:      the public API origin (e.g. https://hackos-api.onrender.com)
# A production build FAILS when this is unset, on purpose.
NEXT_PUBLIC_API_URL=http://localhost:5000

# ─── Hosts (production only) ─────────────────────────────────────────────────
# The marketing site and the product share one deployment. On the hosts listed
# here "/" renders the landing page instead of the organiser console; every
# other path works on every host. Leave both unset locally.
# NEXT_PUBLIC_MARKETING_HOSTS=hack-os.app,www.hack-os.app
# NEXT_PUBLIC_APP_ORIGIN=https://app.hack-os.app
# Canonical marketing origin for absolute URLs in share metadata and the
# sitemap. Defaults to https://www.hack-os.app.
# NEXT_PUBLIC_SITE_URL=https://www.hack-os.app
# Public app URL, used as the referer the AI chat sends to its provider.
# NEXT_PUBLIC_APP_URL=https://app.hack-os.app

# ─── Owner console and entitlements ──────────────────────────────────────────
# The owner console's own host. When set, /workspace and /admin-login are
# served only there and every other host answers 404 for them. Add the domain
# to the Vercel project as well. The owner's e-mail is never configured here:
# the API decides who is the owner (backend SUPERADMIN_EMAILS).
# NEXT_PUBLIC_ADMIN_HOST=admin.hack-os.app
# When "true", the organiser console is gated on an active order for the
# customer (EntitlementGate). Default off.
# NEXT_PUBLIC_REQUIRE_ENTITLEMENT=false

# ─── Telegram (optional) ─────────────────────────────────────────────────────
# Announcements → channel. Sending is done by the API; these are the Next.js
# side: the webhook that mirrors channel posts back into the app, and the
# channel link shown in the header.
# TELEGRAM_ENABLED=true
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=                 # @channel, -100… id, or https://t.me/channel
# TELEGRAM_WEBHOOK_SECRET=          # same value passed to setWebhook (x-telegram-bot-api-secret-token)
# TELEGRAM_SERVICE_SECRET=          # shared with the API for POST /api/announcements/telegram
# TELEGRAM_DEFAULT_EVENT_ID=        # pin mirrored posts to one event (API picks the active one if empty)
# NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=
# NEXT_PUBLIC_TELEGRAM_USERNAME=

# ─── Legal pages (/privacy, /terms, /cookies, /refunds) ────────────────────
# The operator's registered details, printed under "Contact" on each policy.
# Leave unset until they are final: the pages then name the service only
# ("HackOS") instead of showing empty lines. NEXT_PUBLIC_* — rebuild after
# changing them.
# NEXT_PUBLIC_LEGAL_NAME=
# NEXT_PUBLIC_LEGAL_TAX_ID=
# NEXT_PUBLIC_LEGAL_ADDRESS=
# The legal name and VÖEN also appear in the footer of every marketing page
# once set.

# The public contact address (footer, /contact, legal pages). Without it the
# site shows the address it has always used; set a domain mailbox here.
# NEXT_PUBLIC_CONTACT_EMAIL=

# ─── E-mail ──────────────────────────────────────────────────────────────────
# The web app sends no e-mail itself: invites, approvals, password resets and
# submission receipts all go out from the API. Configure the provider there
# (RESEND_API_KEY or BREVO_API_KEY, MAIL_FROM_EMAIL) — see docs/EMAIL.md in
# hack-os-backend. Settings → E-mail delivery shows whether it is ready.

# ─── Event-creator chat (optional) ───────────────────────────────────────────
# /api/chat (the assistant inside the event wizard) calls OpenRouter. Without a
# key the route answers "Chat is not configured" and the wizard still works.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_SITE_URL=

# ─── Server-side route handlers ──────────────────────────────────────────────
# Origin the /api/admin/send-reminders handler uses to reach the API from the
# Next server. Defaults to NEXT_PUBLIC_API_URL.
# BACKEND_URL=

# Set by the Dockerfile to switch on Next's standalone output. Never set on Vercel.
# DOCKER_BUILD=1
